# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets — never commit real environment files
.env
.env.*
!.env.example
!.env.template

# Editor / OS cruft
.idea/
.vscode/
.DS_Store
Thumbs.db

# Generated audit output (regenerated by `harness/run_audit.py --out reports`)
reports/

# Test fixtures deliberately contain planted, FAKE credentials so the scanner has
# real patterns to detect. Keep their .env files tracked despite the rules above,
# otherwise the noncompliant fixture stops reproducing its expected findings.
!harness/fixtures/**/.env
!harness/fixtures/**/.env.*
