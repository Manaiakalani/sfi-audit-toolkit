# Normalize all text files to LF in the repository and on checkout, so the
# byte-reproducible knowledge base (data/*.json regenerated by scripts/build_kb.py)
# stays identical across platforms regardless of a contributor's core.autocrlf
# setting. Without this, a Windows clone could rewrite data/ with CRLF and break
# the KB reproducibility test.
* text=auto eol=lf

# Safeguard common binary types against accidental text normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
